# The site's own public origin. Set this in production.
#
# Link previews, oEmbed and the embeddable player all have to hand a crawler an
# absolute URL — a relative one has no page to resolve against. On Vercel the
# platform's own production host is used when this is unset, so it is only
# strictly required elsewhere; setting it explicitly is still the honest option,
# because it is the one that survives a change of host.
NEXT_PUBLIC_SITE_URL=

# Optional. Powers only the "Ask about this step" tutor panel.
# Without it that panel reports it is not configured and everything else —
# traces, invariants, divergence, complexity — works exactly the same.
ANTHROPIC_API_KEY=

# How much of the tutor one visitor, and one instance, may use.
#
# The tutor is the only route that costs money to answer. The per-client limit
# keeps one reader from being expensive; the per-hour ceiling is the one that
# bounds the bill, because a caller can invent a new forwarding header but
# cannot make the process answer more questions than this. Both default to the
# values below and are per-instance — see src/lib/ai/limit.ts.
ALGOSCOPE_TUTOR_PER_CLIENT=10
ALGOSCOPE_TUTOR_PER_HOUR=200

# Where reading-session signals are kept.
#
# With no Redis credentials the signals go to a file under ALGOSCOPE_DATA_DIR
# (default ./.data), which is right for a machine that owns its own disk. On a
# serverless host that filesystem does not survive the instance, so attach a
# Redis database instead — the confusion map is the one thing here that
# compounds over time, and it only compounds if the rows outlive the request.
#
# Any server speaking the Upstash REST dialect works. The names Upstash's and
# Vercel's own integrations set are picked up automatically, so on those you
# set nothing here at all:
#   UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN
#   KV_REST_API_URL        / KV_REST_API_TOKEN
ALGOSCOPE_DATA_DIR=
ALGOSCOPE_REDIS_REST_URL=
ALGOSCOPE_REDIS_REST_TOKEN=

# Sessions kept before the oldest are dropped. The insights page says when it
# is showing a window rather than the whole history.
ALGOSCOPE_REDIS_MAX_ROWS=50000
